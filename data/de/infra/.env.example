# 이 파일을 .env 로 복사해 환경에 맞게 채운다 (.env 는 커밋 금지)
# 로컬 검증: BE back compose 의 Kafka 주소 (localhost:29092)
# EC2 A: B 서버의 Kafka 주소 (예: j15e105b.p.ssafy.io:9092)
KAFKA_BROKER=

# HDFS 웹 UI 호스트 포트. 로컬 Windows 는 9870이 예약 포트에 걸릴 수 있어 9770 기본,
# EC2 에서는 보안그룹에 맞춰 9870 지정
HDFS_UI_PORT=9770

# Airflow 웹 UI 호스트 포트. 서버 내부(127.0.0.1)에만 묶이므로 SSH 터널로 접속한다
AIRFLOW_UI_PORT=8080

# silver 저장 형식 전환 (S15P21E105-126). 미설정이면 파케이로 지금과 같이 돈다.
# 순서: both 로 같이 쓰기 → 읽기 옮기기 → 파케이 쓰기 끊기. 각 단계는 값을 되돌리면 원복
# SILVER_WRITE=parquet   # parquet | iceberg | both
# SILVER_READ=parquet    # parquet | iceberg

# BE 토픽 발행 (S15P21E105-69). 미설정이면 시험 실행만 하고 보내지 않는다.
# 운영 발행을 켤 때만 send 로 바꾼다. 되돌리기는 이 줄을 지우는 것
# PUBLISH_MODE=dry-run   # dry-run | send
