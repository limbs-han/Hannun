# 이 파일을 .env 로 복사해 환경에 맞게 채운다 (.env 는 커밋 금지)
# 로컬 검증: BE back compose 의 Kafka 주소 (localhost:29092)
# EC2 A: B 서버의 Kafka 주소 (예: j15e105b.p.ssafy.io:9092)
KAFKA_BROKER=

# HDFS 웹 UI 호스트 포트. 로컬 Windows 는 9870이 예약 포트에 걸릴 수 있어 9770 기본,
# EC2 에서는 보안그룹에 맞춰 9870 지정
HDFS_UI_PORT=9770

# Airflow 웹 UI 호스트 포트. 서버 내부(127.0.0.1)에만 묶이므로 SSH 터널로 접속한다
AIRFLOW_UI_PORT=8080
